# Compiler output only - loader/res/ is committed on purpose because
# loader/build.ps1 needs those headers to compile, and a fresh clone must be
# able to build without first running the driver stage.
/build/*

# The throwaway scanners used to recover offsets are worth keeping so the work
# can be reviewed, re-run and diffed on the next patch.
!/build/*.py
!/build/*.md

# Clean-step parking spots for tracked files that live in wiped directories
.iqvw64e.sys.keep
.build-py.keep/

# Python
__pycache__/

# Debugger
node_modules/
league/debugger/ui/dist/
*.pyc
*.obj

# IDE / OS
.vs/
*.user
Thumbs.db
desktop.ini
league/debugger/vite.log
